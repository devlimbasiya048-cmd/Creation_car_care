<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.Master.cs" Inherits="creation_car_care.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Creation Car Care Detailing Studio</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding: 68px 0 0 0; /* Offset for permanently fixed header */
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #fcfbf9;
            color: #111827;
        }

        /* Permanently Fixed Top Navigation Header */
        header.site-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.98);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #f1f5f9;
            box-shadow: 0 2px 14px rgba(0, 0, 0, 0.05);
            transition: all 0.2s ease;
        }

        .header-inner {
            max-width: 1240px;
            margin: 0 auto;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            position: relative;
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 12px;
            flex-shrink: 0;
        }
        .logo-container img {
            height: 42px;
            width: 42px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
        }
        .logo-text h2 {
            margin: 0;
            color: #111827;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
            line-height: 1.2;
            white-space: nowrap;
        }
        .logo-text span {
            display: block;
            font-size: 9px;
            color: #6b7280;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Hamburger button for mobile / zoomed screens */
        .nav-toggle {
            display: none;
            background-color: #fff7ed;
            border: 1.5px solid #fed7aa;
            border-radius: 8px;
            width: 40px;
            height: 40px;
            padding: 9px 8px;
            cursor: pointer;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            outline: none;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
        .nav-toggle:hover {
            background-color: #ffedd5;
            border-color: #ea580c;
        }
        .nav-toggle .bar {
            width: 100%;
            height: 2.5px;
            background-color: #ea580c;
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        .nav-toggle.active .bar:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }
        .nav-toggle.active .bar:nth-child(2) {
            opacity: 0;
        }
        .nav-toggle.active .bar:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* Desktop Navigation */
        nav.main-nav {
            display: flex;
            align-items: center;
            gap: clamp(10px, 1.5vw, 24px);
        }
        nav.main-nav a {
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            color: #374151;
            transition: color 0.2s, background-color 0.2s;
            white-space: nowrap;
            padding: 6px 4px;
        }
        nav.main-nav a:hover {
            color: #ea580c;
        }

        .profile-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 2px solid #ea580c;
            background-color: #fff9f2;
            padding: 4px 16px 4px 6px;
            border-radius: 25px;
            text-decoration: none;
            color: #111827;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .avatar-circle {
            width: 24px;
            height: 24px;
            background-color: #ea580c;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 800;
        }

        .btn-logout {
            background-color: #fee2e2;
            color: #ef4444;
            border: none;
            padding: 8px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s;
            margin-left: 4px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .btn-logout:hover {
            background-color: #fecdd3;
        }

        .main-container {
            padding: 30px 24px;
            min-height: 75vh;
            max-width: 1200px;
            margin: 0 auto;
            box-sizing: border-box;
            width: 100%;
        }

        footer {
            background: #111;
            color: #aaa;
            padding: 40px 20px 20px 20px;
            font-size: 13px;
            margin-top: 50px;
            border-top: 1px solid #333;
            width: 100%;
            box-sizing: border-box;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
            line-height: 2.2;
        }
        .footer-links li a {
            color: #aaa;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }
        .footer-links li a:hover {
            color: #ff9800 !important;
            transform: translateX(5px);
        }
        .footer-contact-link {
            color: #aaa;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .footer-contact-link:hover {
            color: #ff9800 !important;
            text-decoration: underline;
        }

        /* Responsive Breakpoint for Tablets, Mobile & High Zoom Levels */
        @media (max-width: 992px) {
            body {
                padding-top: 60px;
            }

            .header-inner {
                padding: 10px 16px;
            }

            .nav-toggle {
                display: flex;
            }

            nav.main-nav {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                width: 100%;
                background: #ffffff;
                flex-direction: column;
                align-items: stretch;
                padding: 16px 20px 24px;
                gap: 8px;
                border-top: 1px solid #f1f5f9;
                box-shadow: 0 16px 30px rgba(0, 0, 0, 0.08);
                max-height: calc(100vh - 70px);
                overflow-y: auto;
                z-index: 1001;
            }

            nav.main-nav.active {
                display: flex;
                animation: slideDownNav 0.25s ease-out forwards;
            }

            nav.main-nav a {
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 15px;
                display: flex;
                align-items: center;
            }
            nav.main-nav a:hover {
                background-color: #fff7ed;
                color: #ea580c;
            }

            .profile-btn {
                margin: 6px 0;
                align-self: flex-start;
            }

            .btn-logout {
                width: 100%;
                margin: 8px 0 0 0;
                padding: 12px;
                text-align: center;
            }

            .main-container {
                padding: 20px 16px;
            }
        }

        @media (max-width: 600px) {
            body {
                padding-top: 56px;
            }
            .header-inner {
                padding: 8px 12px;
            }
            .logo-text h2 {
                font-size: 13.5px;
            }
            .logo-text span {
                font-size: 8px;
                letter-spacing: 1px;
            }
            .logo-container img {
                height: 34px;
                width: 34px;
            }
            .main-container {
                padding: 16px 12px;
            }
        }

        /* Universal Responsive Utilities */
        img {
            max-width: 100%;
            height: auto;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin-bottom: 15px;
        }

        input[type="text"], input[type="password"], input[type="email"], select, textarea {
            max-width: 100%;
        }

        @keyframes slideDownNav {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <header class="site-header">
            <div class="header-inner">
                <a href="Home.aspx" class="logo-container">
                    <img src="Images/studio_logo.jpeg" alt="Creation Car Care Studio" />
                    <div class="logo-text">
                        <h2>CREATION CAR CARE</h2>
                        <span>DETAILING STUDIO</span>
                    </div>
                </a>

                <!-- Responsive Hamburger Toggle Button -->
                <button type="button" class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </button>

                <nav class="main-nav" id="mainNav">
                    <!-- Guest User Navigation (Matches Screenshot 1) -->
                    <asp:PlaceHolder ID="phGuestNav" runat="server" Visible="true">
                        <a href="Home.aspx" style="<%# GetLinkStyle("home") %>">Home</a>
                        <a href="ServicesList.aspx" style="<%# GetLinkStyle("service") %>">Services</a>
                        <a href="Offer.aspx" style="<%# GetLinkStyle("offer") %>">Offers</a>
                        <a href="About.aspx" style="<%# GetLinkStyle("about") %>">About Us</a>
                        <a href="Contact.aspx" style="<%# GetLinkStyle("contact") %>">Contact Us</a>
                        <a href="Login.aspx" style="<%# GetLinkStyle("login") %>">Login</a>
                        <a href="Register.aspx" style="<%# GetLinkStyle("register") %>">Register</a>
                    </asp:PlaceHolder>

                    <!-- Logged In User Navigation (Matches Screenshot 2) -->
                    <asp:PlaceHolder ID="phUserNav" runat="server" Visible="false">
                        <a href="Home.aspx" style="<%# GetLinkStyle("home") %>">Home</a>
                        <a href="ServicesList.aspx" style="<%# GetLinkStyle("service") %>">Services</a>
                        <a href="Offer.aspx" style="<%# GetLinkStyle("offer") %>">Offers</a>
                        <a href="About.aspx" style="<%# GetLinkStyle("about") %>">About Us</a>
                        <a href="Contact.aspx" style="<%# GetLinkStyle("contact") %>">Contact Us</a>
                        <a href="Wishlist.aspx" style="<%# GetLinkStyle("wishlist") %>">Wishlist</a>
                        <a href="Cart.aspx" style="<%# GetLinkStyle("cart") %>">Cart</a>
                        <a href="Booking.aspx" style="<%# GetLinkStyle("booking") %>">Booking</a>

                        <asp:HyperLink ID="hlAdminPanel" runat="server" NavigateUrl="~/Admin/Dashboard.aspx" Visible="false" style="color: #b91c1c; font-weight: 800; background: #fee2e2; padding: 6px 12px; border-radius: 6px; text-decoration: none;">&#9881; Admin</asp:HyperLink>

                        <a href="Profile.aspx" class="profile-btn">
                            <span class="avatar-circle">
                                <asp:Label ID="lblAvatar" runat="server" Text="D"></asp:Label>
                            </span>
                            <span>Profile</span>
                        </a>

                        <asp:Button ID="btnLogout" runat="server" Text="Logout" OnClick="btnLogout_Click" CssClass="btn-logout" CausesValidation="false" />
                    </asp:PlaceHolder>
                </nav>
            </div>
        </header>

        <div class="main-container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer>
            <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 30px; text-align: left;">
                <div style="flex: 1; min-width: 200px;">
                    <h4 style="color: #fff; font-size: 15px; margin-bottom: 15px; border-bottom: 2px solid #ff9800; display: inline-block; padding-bottom: 5px;">About Studio</h4>
                    <ul class="footer-links">
                        <li><a href="Home.aspx">Home Catalog</a></li>
                        <li><a href="ServicesList.aspx">Ceramic &amp; PPF Info</a></li>
                        <li><a href="ServicesList.aspx">Studio Packages</a></li>
                        <li><a href="About.aspx">Customer Reviews</a></li>
                    </ul>
                </div>

                <div style="flex: 1; min-width: 200px;">
                    <h4 style="color: #fff; font-size: 15px; margin-bottom: 15px; border-bottom: 2px solid #ff9800; display: inline-block; padding-bottom: 5px;">Help &amp; Support</h4>
                    <ul class="footer-links">
                        <li><a href="BookSlot.aspx">Booking Guide</a></li>
                        <li><a href="Contact.aspx">Contact Studio</a></li>
                        <li><a href="HelpSupport.aspx">FAQs</a></li>
                    </ul>
                </div>

                <div style="flex: 1; min-width: 200px;">
                    <h4 style="color: #fff; font-size: 15px; margin-bottom: 15px; border-bottom: 2px solid #ff9800; display: inline-block; padding-bottom: 5px;">Studio Location</h4>
                    <p style="color: #aaa; line-height: 1.8; margin: 0;">
                        <a href="https://maps.google.com/?q=Nagrik+Bank+Chowk,+Rajkot" target="_blank" rel="noopener noreferrer" class="footer-contact-link">📍 Nagrik Bank Chowk, Rajkot-360001.</a><br />
                        🕒 Open All Days: 09:00 AM - 08:00 PM<br />
                        📞 Phone: <a href="tel:+919876543210" class="footer-contact-link">+91 98765 43210</a>
                    </p>
                </div>

                <div style="flex: 1; min-width: 200px;">
                    <h4 style="color: #fff; font-size: 15px; margin-bottom: 15px; border-bottom: 2px solid #ff9800; display: inline-block; padding-bottom: 5px;">Follow Us</h4>
                    <ul class="footer-links">
                        <li><a href="https://www.instagram.com/creation_cars_care" target="_blank" rel="noopener noreferrer">📷 Instagram</a></li>
                        <li><a href="https://www.youtube.com/@Creation_car_care" target="_blank" rel="noopener noreferrer">▶️ YouTube</a></li>
                    </ul>
                </div>
            </div>

            <div style="border-top: 1px solid #222; margin-top: 30px; padding-top: 15px; font-size: 12px; color: #666; text-align: center;">
                &copy; 2026 Creation Car Care Detailing Studio. All rights reserved.
            </div>
        </footer>
    </form>

    <script type="text/javascript">
        (function () {
            function initNav() {
                var toggle = document.getElementById('navToggle');
                var nav = document.getElementById('mainNav');
                if (!toggle || !nav) return;

                // Remove existing listeners by clone replacement to avoid double binding
                var newToggle = toggle.cloneNode(true);
                toggle.parentNode.replaceChild(newToggle, toggle);
                toggle = newToggle;

                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var isActive = toggle.classList.toggle('active');
                    nav.classList.toggle('active');
                    toggle.setAttribute('aria-expanded', isActive ? 'true' : 'false');
                });

                document.addEventListener('click', function (e) {
                    if (!nav.contains(e.target) && !toggle.contains(e.target)) {
                        toggle.classList.remove('active');
                        nav.classList.remove('active');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });

                var navLinks = nav.querySelectorAll('a, .btn-logout');
                for (var i = 0; i < navLinks.length; i++) {
                    navLinks[i].addEventListener('click', function () {
                        if (window.innerWidth <= 992) {
                            toggle.classList.remove('active');
                            nav.classList.remove('active');
                            toggle.setAttribute('aria-expanded', 'false');
                        }
                    });
                }

                window.addEventListener('resize', function () {
                    if (window.innerWidth > 992) {
                        toggle.classList.remove('active');
                        nav.classList.remove('active');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initNav);
            } else {
                initNav();
            }

            if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(initNav);
            }
        })();
    </script>
</body>
</html>